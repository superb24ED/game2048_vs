    LTEXT           "",IDC_STATIC_RANK,14,42,212,16
    LTEXT           "",IDC_STATIC_SCORE_CUR,14,62,212,16
    LTEXT           "",IDC_STATIC_CONGRATS,14,100,212,14
    DEFPUSHBUTTON   "好的",IDOK,178,118,48,14,WS_GROUP
END


