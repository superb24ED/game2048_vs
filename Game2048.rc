// 中文(简体，中国) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_GAME2048            ICON                    "Game2048.ico"

IDI_SMALL               ICON                    "small.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_GAME2048 MENU
BEGIN
    POPUP "游戏(&G)"
    BEGIN
        MENUITEM "新游戏(&N)",                     IDM_NEWGAME
        MENUITEM "排行榜(&L)",                     IDM_LEADERBOARD
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                      IDM_EXIT
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于(&A) ...",                  IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_GAME2048 ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 Game2048"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_GAME2048,IDC_STATIC,14,14,20,20
    LTEXT           "Game2048, 版本 1.0\nSuperb24ED\n2903665506@qq.com",IDC_STATIC,40,14,114,21,SS_NOPREFIX
    LTEXT           "版权所有(c) 2024",IDC_STATIC,40,30,114,8,0,WS_EX_TRANSPARENT
    DEFPUSHBUTTON   "确定",IDOK,113,41,50,14,WS_GROUP
END

IDD_GAMEOVER_DIALOG DIALOGEX 0, 0, 148, 63
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_CAPTION | WS_SYSMENU
CAPTION "Game2048"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "重新开始(&R)",IDC_BUTTON_CONTINUE,10,40,50,14
    PUSHBUTTON      "取消(&C)",IDC_BUTTON_CANCEL,88,40,50,14
    CTEXT           "游戏结束!",IDC_STATIC,10,10,128,20,SS_CENTERIMAGE
END

IDD_FIRSTWIN_DIALOG DIALOGEX 0, 0, 188, 81
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_CAPTION | WS_SYSMENU
CAPTION "你赢了"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "继续挑战(&R)",IDC_BUTTON_CONTINUE,29,60,50,14
    PUSHBUTTON      "新的游戏(&N)",IDC_BUTTON_NEWGAME,101,60,50,14
    CTEXT           "成功获取2048！\n是否继续游戏?",IDC_STATIC,47,23,100,28
END

IDD_LEADERBOARD_DIALOG DIALOGEX 0, 0, 260, 300
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "排行榜 - Top 10"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "??  Game2048  排 行 榜  -  Top 10",IDC_STATIC,14,8,232,14,SS_CENTER
    LTEXT           "名次  玩家                分数      达成时间",IDC_STATIC,14,24,232,10
    LISTBOX         IDC_LIST_SCORES,14,36,232,196,LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT           "",IDC_STATIC_SCORE_CUR,14,240,160,10
    PUSHBUTTON      "清空排行榜(&C)",IDC_BUTTON_CLEAR,14,274,70,14
    DEFPUSHBUTTON   "确定",IDOK,200,274,46,14,WS_GROUP
END

IDD_INPUTNAME_DIALOG DIALOGEX 0, 0, 210, 90
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "恭喜入榜！"
FONT 9, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CTEXT           "恭喜进入榜单！留下您的大名吧～\n(留空则以「匿名玩家」保存)",IDC_STATIC,14,10,182,24
    EDITTEXT        IDC_EDIT_NAME,19,42,172,14,ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON   "确定(&O)",IDOK,90,66,50,14,WS_GROUP
    PUSHBUTTON      "跳过(&S)",IDCANCEL,144,66,50,14
END

IDD_NEWRECORD_DIALOG DIALOGEX 0, 0, 240, 140
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "?? 新纪录！"
FONT 9, "MS Shell Dlg", 700, 0, 0x1
BEGIN
